{
  "name": "CatPaw PixVerse v2｜I2V End-to-End",
  "nodes": [
    {
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -1120,
        -260
      ],
      "parameters": {}
    },
    {
      "name": "Test Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -900,
        -260
      ],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "image_url",
              "value": "https://res.cloudinary.com/y8tb8gsj/image/upload/v1790299930/1000018915.png"
            },
            {
              "name": "prompt",
              "value": "cinematic female wuxia cat warrior, subtle head turn, gentle cloth movement, soft glowing energy, stable face, stable costume, stable weapon, locked composition, high character consistency"
            },
            {
              "name": "model",
              "value": "v6"
            },
            {
              "name": "quality",
              "value": "720p"
            }
          ],
          "number": [
            {
              "name": "duration",
              "value": 5
            }
          ],
          "boolean": [
            {
              "name": "batch",
              "value": false
            },
            {
              "name": "publish",
              "value": false
            }
          ]
        }
      }
    },
    {
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1120,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "catpaw-pixverse-v2",
        "responseMode": "lastNode"
      }
    },
    {
      "name": "Validate + Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -900,
        0
      ],
      "parameters": {
        "jsCode": "const x=$json.body ?? $json;\nif(!x.prompt) throw new Error('prompt required');\nif(!x.img_id && !x.image_url) throw new Error('img_id or image_url required');\nif(x.publish===true) throw new Error('auto publish is locked');\nif(x.batch===true) throw new Error('batch generation is locked');\nconst duration=Number(x.duration ?? 5);\nif(![5,8,10].includes(duration)) throw new Error('duration must be 5/8/10');\nreturn [{json:{\n  job_id:x.job_id ?? 'PV-'+Date.now(),\n  image_url:x.image_url || null,\n  img_id:x.img_id ? Number(x.img_id) : null,\n  prompt:x.prompt,\n  negative_prompt:x.negative_prompt ?? 'deformed face, extra limbs, duplicate weapon, text artifacts, watermark',\n  model:x.model ?? 'v6',\n  quality:x.quality ?? '720p',\n  duration,\n  motion_mode:x.motion_mode ?? 'normal',\n  seed:Number(x.seed ?? 0),\n  template_id:x.template_id ? Number(x.template_id) : undefined,\n  camera_movement:x.camera_movement ?? undefined,\n  paid:true,publish:false,batch:false\n}}];"
      }
    },
    {
      "name": "Has img_id?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -680,
        0
      ],
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.img_id || 0}}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      }
    },
    {
      "name": "Download Reference Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -460,
        120
      ],
      "parameters": {
        "method": "GET",
        "url": "={{$json.image_url}}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      }
    },
    {
      "name": "PixVerse Upload Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -220,
        120
      ],
      "parameters": {
        "method": "POST",
        "url": "https://app-api.pixverse.ai/openapi/v2/image/upload",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "API-KEY",
              "value": "={{$env.PIXVERSE_API_KEY}}"
            },
            {
              "name": "Ai-trace-id",
              "value": "={{$now.toMillis() + '-upload'}}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "image",
              "inputDataFieldName": "data"
            }
          ]
        }
      }
    },
    {
      "name": "Extract img_id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,
        120
      ],
      "parameters": {
        "jsCode": "const r=$json;\nif(r.ErrCode!==0) throw new Error('PixVerse upload failed: '+(r.ErrMsg||JSON.stringify(r)));\nconst imgId=r.Resp?.img_id ?? r.Resp?.id;\nif(!imgId) throw new Error('PixVerse img_id missing after upload');\nreturn [{json:{...$('Validate + Gate').item.json,img_id:Number(imgId)}}];"
      }
    },
    {
      "name": "Use Existing img_id",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -220,
        -120
      ],
      "parameters": {
        "values": {
          "number": [
            {
              "name": "img_id",
              "value": "={{$json.img_id}}"
            }
          ]
        },
        "options": {
          "dotNotation": false
        }
      }
    },
    {
      "name": "Build Submit Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "jsCode": "const x=$json;\nreturn [{json:{...x,submit_body:{\n duration:x.duration,\n img_id:Number(x.img_id),\n model:x.model,\n motion_mode:x.motion_mode,\n prompt:x.prompt,\n negative_prompt:x.negative_prompt,\n quality:x.quality,\n seed:x.seed,\n ...(x.template_id?{template_id:x.template_id}:{}),\n ...(x.camera_movement?{camera_movement:x.camera_movement}:{})\n}}}];"
      }
    },
    {
      "name": "PixVerse Submit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://app-api.pixverse.ai/openapi/v2/video/img/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "API-KEY",
              "value": "={{$env.PIXVERSE_API_KEY}}"
            },
            {
              "name": "Ai-trace-id",
              "value": "={{$now.toMillis() + '-' + $json.job_id}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.submit_body) }}"
      }
    },
    {
      "name": "Check Submit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        0
      ],
      "parameters": {
        "jsCode": "const r=$json;\nif(r.ErrCode!==0) throw new Error('PixVerse submit failed: '+(r.ErrMsg||JSON.stringify(r)));\nif(!r.Resp?.video_id) throw new Error('PixVerse video_id missing');\nreturn [{json:{video_id:r.Resp.video_id,poll_count:0}}];"
      }
    },
    {
      "name": "Wait 5s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        980,
        0
      ],
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      }
    },
    {
      "name": "PixVerse Poll",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1220,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{'https://app-api.pixverse.ai/openapi/v2/video/result/'+$json.video_id}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "API-KEY",
              "value": "={{$env.PIXVERSE_API_KEY}}"
            },
            {
              "name": "Ai-trace-id",
              "value": "={{$now.toMillis() + '-poll-' + $json.video_id}}"
            }
          ]
        }
      }
    },
    {
      "name": "Normalize Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1460,
        0
      ],
      "parameters": {
        "jsCode": "const r=$json;\nif(r.ErrCode!==0) throw new Error('PixVerse poll failed: '+(r.ErrMsg||JSON.stringify(r)));\nconst x=r.Resp||{};\nif(x.status===7) throw new Error('PixVerse moderation failed');\nif(x.status===8) throw new Error('PixVerse generation failed');\nreturn [{json:{done:x.status===1,video_id:x.id,status:x.status,url:x.url||null,result:x}}];"
      }
    },
    {
      "name": "Done?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1700,
        0
      ],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.done}}",
              "operation": "isTrue"
            }
          ]
        }
      }
    },
    {
      "name": "Return Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1940,
        -120
      ],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "provider",
              "value": "pixverse"
            },
            {
              "name": "status",
              "value": "success"
            },
            {
              "name": "video_url",
              "value": "={{$json.url}}"
            },
            {
              "name": "video_id",
              "value": "={{$json.video_id}}"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Validate + Gate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate + Gate": {
      "main": [
        [
          {
