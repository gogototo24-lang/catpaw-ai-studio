            "index": 0
          }
        ]
      ]
    },
    "Use Existing img_id": {
      "main": [
        [
          {
            "node": "Build Submit Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Submit Payload": {
      "main": [
        [
          {
            "node": "PixVerse Submit",
