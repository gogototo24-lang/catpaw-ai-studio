{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Catpaw AI Studio Production Job",
  "type":"object",
  "required":["version","character","duration","style","status","production_pack"],
  "properties":{
    "version":{"type":"string","const":"1.7"},
    "character":{"type":"string"},
    "duration":{"type":"string"},
    "style":{"type":"string"},
    "status":{"enum":["草稿","待生成","待剪輯","完成"]},
    "production_pack":{"type":"string"},
    "created_at":{"type":"string"}
  }
}